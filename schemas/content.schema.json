{
  "$defs": {
    "sourceRefs": {
      "items": {
        "properties": {
          "item": {
            "type": "string"
          },
          "pdfPage": {
            "type": "integer"
          },
          "printedPage": {
            "type": "integer"
          },
          "section": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          }
        },
        "required": [
          "sourceId"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "$id": "hsk30-content",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "books": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "publicationStatus": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "titleEn": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "level",
          "kind",
          "titleEn",
          "sourceId",
          "publicationStatus"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "contentVersion": {
      "type": "string"
    },
    "lessons": {
      "items": {
        "properties": {
          "bookId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "publicationStatus": {
            "enum": [
              "pilot-ready",
              "catalogue-only",
              "checking",
              "no-source",
              "source-error"
            ]
          },
          "sourceRefs": {
            "$ref": "#/$defs/sourceRefs"
          },
          "sourceUnit": {
            "type": "string"
          },
          "titleEn": {
            "type": "string"
          },
          "titleVi": {
            "type": "string"
          },
          "titleZh": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "bookId",
          "level",
          "sourceUnit",
          "titleZh",
          "titleEn",
          "titleVi",
          "sourceRefs",
          "publicationStatus"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "pilot": {
      "properties": {
        "exerciseSet": {
          "properties": {
            "items": {
              "items": {
                "properties": {
                  "answer": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "answerStatus": {
                    "enum": [
                      "verified-from-print",
                      "verified-from-visual",
                      "unverified"
                    ]
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pinyin": {
                          "type": "string"
                        },
                        "vi": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "promptVi",
                  "options",
                  "answerStatus",
                  "explanationVi",
                  "sourceRefs"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "knowledgePoints": {
          "items": {
            "properties": {
              "sourceRefs": {
                "$ref": "#/$defs/sourceRefs"
              }
            },
            "required": [
              "id",
              "kind",
              "kindLabel",
              "title",
              "explanationVi",
              "pattern",
              "sourceRefs"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "lessonId": {
          "type": "string"
        },
        "prepWords": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hanViet": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Âm Hán–Việt viết hoa; null khi hanVietStatus=missing"
              },
              "hanVietStatus": {
                "enum": [
                  "verified-editorial",
                  "missing"
                ]
              },
              "hanVietNoteVi": {
                "type": "string"
              }
            },
            "required": [
              "hanVietStatus"
            ]
          }
        },
        "selfCheckTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "speaking",
                  "listening-comparison"
                ]
              },
              "practiceEvidence": {
                "type": "string"
              },
              "audioSegment": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "start",
                  "end"
                ]
              },
              "audioSegmentStatus": {
                "type": "string"
              },
              "promptImages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "src",
                    "alt",
                    "captionVi",
                    "sourceRefs"
                  ]
                }
              }
            },
            "not": {
              "required": [
                "segment"
              ]
            }
          }
        }
      },
      "required": [
        "lessonId",
        "intro",
        "prepWords",
        "knowledgePoints",
        "reader",
        "exerciseSet",
        "selfCheckTasks",
        "apply"
      ],
      "type": "object"
    },
    "sources": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string"
          },
          "rightsEvidence": {
            "type": "string"
          },
          "rightsStatus": {
            "enum": [
              "unknown",
              "link-only",
              "embed-permitted",
              "redistribution-permitted",
              "restricted"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "url",
          "retrievedAt",
          "rightsStatus",
          "verification"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "additionalLessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exerciseSet": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "answer": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "answerStatus": {
                      "enum": [
                        "verified-from-print",
                        "verified-from-visual",
                        "unverified"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "promptVi",
                    "options",
                    "answerStatus",
                    "explanationVi",
                    "sourceRefs"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "knowledgePoints": {
            "items": {
              "properties": {
                "sourceRefs": {
                  "$ref": "#/$defs/sourceRefs"
                }
              },
              "required": [
                "id",
                "kind",
                "kindLabel",
                "title",
                "explanationVi",
                "pattern",
                "sourceRefs"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "lessonId": {
            "type": "string"
          },
          "selfCheckTasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "speaking",
                    "listening-comparison"
                  ]
                },
                "practiceEvidence": {
                  "type": "string"
                },
                "audioSegment": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ]
                },
                "audioSegmentStatus": {
                  "type": "string"
                },
                "promptImages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "src",
                      "alt",
                      "captionVi",
                      "sourceRefs"
                    ]
                  }
                }
              },
              "not": {
                "required": [
                  "segment"
                ]
              }
            }
          }
        },
        "required": [
          "lessonId",
          "intro",
          "prepWords",
          "knowledgePoints",
          "reader",
          "exerciseSet",
          "selfCheckTasks",
          "apply"
        ]
      }
    }
  },
  "required": [
    "contentVersion",
    "sources",
    "books",
    "lessons",
    "pilot"
  ],
  "title": "HSK 3.0 app content",
  "type": "object"
}
